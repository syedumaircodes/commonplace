---
config:
  flowchart:
    nodeSpacing: 24
    rankSpacing: 56
    padding: 16
---
flowchart TB
  subgraph SIGNUP["at sign-up"]
    direction LR
    P1["password<br/>hunter2"] --> H1["hash function<br/>one-way, fixed length"] --> S1["password hash<br/>9f86d081…"] --> DB1["database<br/>stores only the hash<br/>password discarded"]
  end

  subgraph SIGNIN["at sign-in"]
    direction LR
    P2["password typed<br/>hunter2"] --> H2["hash function<br/>same input, same hash"] --> S2["new hash<br/>9f86d081…"] --> C2["compare with stored hash<br/>match: signed in<br/>mismatch: denied"]
  end

  %% Invisible link only stacks the two panels vertically.
  SIGNUP ~~~ SIGNIN

  classDef inputCard fill:#17253d,stroke:#5b7bd5,color:#dbe8ff
  classDef hashCard fill:#151b25,stroke:#3f3f3f,color:#ededed
  classDef safeCard fill:#173a2a,stroke:#3f8f63,color:#d6f5e3

  class P1,P2 inputCard
  class H1,H2 hashCard
  class S1,S2,DB1,C2 safeCard

  style SIGNUP fill:#101820,stroke:#3f3f3f,color:#ededed
  style SIGNIN fill:#101820,stroke:#3f3f3f,color:#ededed

  linkStyle default stroke:#7a7a7a,stroke-width:1.5px
