flowchart TB
  subgraph you["you"]
    direction LR
    Y1["write: the code"] ~~~ Y2["pick: libraries"]
  end

  subgraph app["app"]
    direction LR
    A1["names: people"] ~~~ A2["passwords: secret"]
    A3["payments: money"] ~~~ A4["visits: booked"]
  end

