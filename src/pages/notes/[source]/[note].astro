---
import Layout from "@/layouts/main.astro"
import { notes, sourceSlug } from "@/lib/notes"

export function getStaticPaths() {
  return notes.map((note) => ({
    params: {
      source: sourceSlug(note.data.sourceTitle),
      note: note.data.slug,
    },
    props: { note },
  }))
}

const { note } = Astro.props
const { Content } = note
const source = sourceSlug(note.data.sourceTitle)
const noteImages = `/images/notes/${source}/`
---

<Layout title={note.data.title} type="article" description={note.data.excerpt}>
  <main class="min-h-svh">
    <div class="mx-auto flex min-h-svh w-full max-w-3xl flex-col bg-background">
      <article class="mx-auto w-full max-w-[41rem] flex-1 px-6 pb-20 pt-8 sm:px-10 sm:pt-10">
        <nav aria-label="Breadcrumb" class="label-caps">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <li>
              <a href="/" class="hover:text-foreground">
                ← All sources
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li>
              <a
                href={`/notes/${source}/`}
                class="hover:text-foreground"
              >
                {note.data.sourceTitle}
              </a>
            </li>
          </ol>
        </nav>

        <header class="pb-8 sm:pb-10">
          <h1 class="display-type text-heading mt-4 break-words text-foreground">
            {note.data.title}
          </h1>
          {note.data.sample && (
            <p class="mt-4 font-serif text-[1.0625rem] leading-[1.5] text-muted-foreground italic">
              A sample note, still growing — replace it with your own.
            </p>
          )}
        </header>

        <div class="mdx-content">
          <Content
            components={{
              img: (props: { src?: string; alt?: string; title?: string }) => (
                <img
                  {...props}
                  src={
                    props.src?.startsWith("./")
                      ? `${noteImages}${props.src.slice(2)}`
                      : props.src
                  }
                  loading="lazy"
                  decoding="async"
                />
              ),
            }}
          />
        </div>
      </article>
    </div>
  </main>
</Layout>
