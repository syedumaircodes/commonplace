---
import Layout from "@/layouts/main.astro"
import NoteSidebar from "@/components/note-sidebar.astro"
import { notes as noteEntries, sourceSlug, type NoteData, type NoteEntry } from "@/lib/notes"

export function getStaticPaths() {
  const groups = new Map<string, NoteEntry[]>()
  for (const note of noteEntries) {
    const key = sourceSlug(note.data.sourceTitle)
    const group = groups.get(key) ?? []
    group.push(note)
    groups.set(key, group)
  }
  return Array.from(groups.values()).flatMap((group) => {
    const note = group[0]
    return {
      params: {
        source: sourceSlug(note.data.sourceTitle),
      },
      props: {
        source: note.data,
        notes: group,
      },
    }
  })
}

type Props = {
  source: NoteData
  notes: NoteEntry[]
}

const { source, notes } = Astro.props as Props
const sourceSlugValue = sourceSlug(source.sourceTitle)
---

<Layout title={source.sourceTitle} type="article" description={source.sourceDetail}>
  <div class="flex flex-1 flex-col lg:flex-row">
    <NoteSidebar
      sourceTitle={source.sourceTitle}
      notes={notes.map(({ data }) => data)}
    />

    <main class="min-w-0 flex-1">
      <article class="note mx-auto w-full max-w-[42rem] px-5 pb-16 pt-10 sm:px-8 sm:pt-14">
        <header class="note__header">
          <h1 class="display-type text-heading break-words text-foreground">
            {source.sourceTitle}
          </h1>

          {
            source.sourceDetail && (
              <p class="note__context">{source.sourceDetail}</p>
            )
          }
        </header>

        <ol class="mt-10 space-y-3">
          {
            notes.map(({ data }, index) => (
              <li>
                <a
                  href={`/notes/${sourceSlugValue}/${data.slug}/`}
                  class="collection-entry"
                >
                  <span class="collection-entry__index" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="collection-entry__body">
                    <span class="collection-entry__title">
                      {data.title}
                    </span>
                    {data.excerpt && (
                      <span class="collection-entry__excerpt">
                        {data.excerpt}
                      </span>
                    )}
                  </span>
                  <svg
                    class="collection-entry__arrow h-3.5 w-3.5 shrink-0"
                    viewBox="0 0 12 12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4.5 2.5L8.5 6l-4 3.5" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ol>
      </article>
    </main>
  </div>
</Layout>
