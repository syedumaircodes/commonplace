---
import Layout from "@/layouts/main.astro"
import SiteFooter from "@/components/site-footer.astro"
import SiteHeader from "@/components/site-header.astro"
import { notes, sourceSlug, topics } from "@/lib/topics"

export function getStaticPaths() {
  return topics.map(({ data }) => ({ params: { slug: data.slug } }))
}

const { slug } = Astro.params
const topic = topics.find(({ data }) => data.slug === slug)

if (!topic) {
  return Astro.redirect("/")
}

const topicNotes = notes.filter(({ data }) => data.topic === slug)
const sources = Array.from(
  new Map(
    topicNotes.map(({ data }) => [sourceSlug(data.sourceTitle), data])
  ).entries()
).map(([sourceSlugValue, data]) => ({ sourceSlug: sourceSlugValue, ...data }))
const { Content } = topic
---

<Layout>
  <main class="min-h-svh">
    <div class="mx-auto flex min-h-svh w-full max-w-6xl flex-col bg-background">
      <SiteHeader />

      <section class="mx-auto flex w-full max-w-6xl flex-1 flex-col px-6 sm:px-10 lg:px-16">
        <div class="flex flex-1 flex-col justify-center py-16 sm:py-20">
          <h1
            class="max-w-[20ch] text-[clamp(2.5rem,7vw,5rem)] leading-[0.98] font-semibold tracking-[-0.045em] text-foreground text-balance"
          >
            {topic.data.name}
          </h1>

          <p
            class="mt-8 max-w-[54ch] text-base leading-relaxed text-muted-foreground sm:text-lg"
          >
            {topic.data.description}
          </p>

          <div class="prose-sample mt-8 max-w-[60ch] text-sm leading-6 text-muted-foreground">
            <Content />
          </div>
        </div>

        <section class="border-t border-hairline">
          <ul>
            {sources.map((source, index) => (
              <li class="border-t border-hairline">
                <a
                  href={`/notes/${slug}/${source.sourceSlug}/`}
                  class="grid grid-cols-[2.5rem_1fr] items-baseline gap-x-4 gap-y-1 py-6 sm:grid-cols-[3.5rem_1fr_auto] sm:py-7"
                >
                  <span class="font-mono text-[0.6875rem] tracking-[0.14em] text-muted-foreground">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="text-lg leading-snug font-medium tracking-[-0.01em] text-foreground sm:text-xl">
                    {source.sourceTitle}
                  </span>

                  <span class="col-start-2 row-start-2 text-sm text-muted-foreground sm:col-start-3 sm:row-start-1 sm:text-right">
                    {source.sourceKind}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </section>

      <SiteFooter backHref="/" backLabel="All topics" />
    </div>
  </main>
</Layout>
