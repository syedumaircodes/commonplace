---
import Layout from "@/layouts/main.astro"
import { notes, sourceSlug, topics } from "@/lib/topics"
import { SITE } from "@/lib/site"

export function getStaticPaths() {
  return topics.map(({ data }) => ({ params: { slug: data.slug } }))
}

const { slug } = Astro.params
const topic = topics.find(({ data }) => data.slug === slug)

if (!topic) {
  return Astro.redirect("/")
}

const topicNotes = notes.filter(({ data }) => data.topic === slug)
const sources = Array.from(
  new Map(
    topicNotes.map(({ data }) => [sourceSlug(data.sourceTitle), data])
  ).entries()
).map(([sourceSlugValue, data]) => ({ sourceSlug: sourceSlugValue, ...data }))
const { Content } = topic
---

<Layout
  title={topic.data.name}
  description={`${topic.data.description} — notes and references from ${SITE.name}, a living spirit library curated by ${SITE.author.handle}.`}
>
  <main class="min-h-svh">
    <div class="mx-auto flex min-h-svh w-full max-w-3xl flex-col bg-background">
      <section class="mx-auto flex w-full max-w-3xl flex-1 flex-col px-6 sm:px-10">
        <div class="flex flex-col py-14 sm:py-16">
          <p class="label-caps mb-3">
            <a href="/" class="hover:text-foreground">
              ← All topics
            </a>
          </p>

          <h1 class="display-type text-title max-w-[24ch] text-foreground">
            {topic.data.name}
          </h1>

          <p class="text-lede mt-6 max-w-[54ch] text-pretty text-muted-foreground">
            {topic.data.description}
          </p>

          <div class="mdx-content topic-blurb mt-6 max-w-[58ch] text-muted-foreground">
            <Content />
          </div>
        </div>

        <section>
          <h2 class="label-caps mb-2">Sources</h2>
          <ul>
            {sources.map((source) => (
              <li class="border-t border-hairline">
                <a
                  href={`/notes/${slug}/${source.sourceSlug}/`}
                  class="block py-6 sm:py-7"
                >
                  <span class="display-type block text-[1.4375rem] leading-[1.2] text-foreground sm:text-[1.5625rem]">
                    {source.sourceTitle}
                  </span>

                  {source.sourceDetail && (
                    <span class="mt-1.5 block max-w-[56ch] text-[0.9375rem] leading-[1.65] text-pretty text-muted-foreground">
                      {source.sourceDetail}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      </section>
    </div>
  </main>
</Layout>
