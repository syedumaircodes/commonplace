---
import Layout from "@/layouts/main.astro"
import { notes, sourceSlug, topics } from "@/lib/topics"

export function getStaticPaths() {
  return notes.flatMap((note) => {
    const topic = topics.find(({ data }) => data.slug === note.data.topic)
    if (!topic) return []

    return [
      {
        params: {
          slug: note.data.topic,
          source: sourceSlug(note.data.sourceTitle),
          note: note.data.slug,
        },
        props: { note, topic },
      },
    ]
  })
}

const { note, topic } = Astro.props
const { Content } = note
const source = sourceSlug(note.data.sourceTitle)
---

<Layout>
  <main class="min-h-svh">
    <div class="mx-auto flex min-h-svh w-full max-w-7xl flex-col bg-background">
      <header class="px-6 pt-6 sm:px-10 sm:pt-8 md:px-12">
        <a
          href="/"
          aria-label="commonplace home"
          class="inline-flex items-center gap-2 py-2 text-sm font-semibold tracking-tight transition-colors hover:text-muted-foreground"
        >
          <span aria-hidden="true">←</span>
          <span>commonplace</span>
        </a>
      </header>

      <article class="mx-auto w-full max-w-3xl flex-1 px-6 pb-16 pt-10 sm:px-10 sm:pt-14 md:px-12 md:pt-16">
        <nav
          aria-label="Breadcrumb"
          class="mb-10 flex flex-wrap items-center gap-2 text-sm text-muted-foreground"
        >
          <a
            href={`/notes/${topic.data.slug}/`}
            class="transition-colors hover:text-foreground"
          >
            {topic.data.name}
          </a>
          <span aria-hidden="true">/</span>
          <a
            href={`/notes/${topic.data.slug}/${source}/`}
            class="transition-colors hover:text-foreground"
          >
            {note.data.sourceTitle}
          </a>
        </nav>

        <header class="border-b border-border pb-8 sm:pb-10">
          <h1 class="mt-3 break-words text-3xl leading-tight font-semibold tracking-[-0.03em] sm:text-4xl md:text-5xl">
            {note.data.title}
          </h1>
          {note.data.sample && (
            <p class="mt-4 inline-flex rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">
              Sample note · replace with your own
            </p>
          )}
        </header>

        <div class="mdx-content mt-8 text-base leading-7 text-foreground/90 sm:mt-10">
          <Content />
        </div>
      </article>

      <footer class="flex items-center justify-between border-t border-border px-6 py-4 text-xs text-muted-foreground sm:px-10 md:px-16 lg:px-24">
        <a
          href={`/notes/${topic.data.slug}/${source}/`}
          class="transition-colors hover:text-foreground"
        >
          ← Back to {note.data.sourceTitle}
        </a>
        <span>© {new Date().getFullYear()} commonplace</span>
      </footer>
    </div>
  </main>
</Layout>
