---
import Layout from "@/layouts/main.astro"
import SiteFooter from "@/components/site-footer.astro"
import SiteHeader from "@/components/site-header.astro"
import { notes as noteEntries, sourceSlug, topics } from "@/lib/topics"

export function getStaticPaths() {
  const groups = new Map()
  for (const note of noteEntries) {
    const key = `${note.data.topic}/${sourceSlug(note.data.sourceTitle)}`
    const group = groups.get(key) ?? []
    group.push(note)
    groups.set(key, group)
  }
  return Array.from(groups.values()).flatMap((group) => {
    const note = group[0]
    const topic = topics.find(({ data }) => data.slug === note.data.topic)
    if (!topic) return []
    return {
      params: {
        slug: note.data.topic,
        source: sourceSlug(note.data.sourceTitle),
      },
      props: {
        topic,
        source: note.data,
        notes: group,
      },
    }
  })
}

const { topic, source, notes } = Astro.props
---

<Layout>
  <main class="min-h-svh">
    <div class="mx-auto flex min-h-svh w-full max-w-6xl flex-col bg-background">
      <SiteHeader />

      <div class="mx-auto w-full max-w-6xl flex-1 px-6 sm:px-10 lg:px-16">
        <header class="flex flex-col justify-center py-16 sm:py-20">
          <h1
            class="max-w-[24ch] text-[clamp(2rem,5.5vw,3.75rem)] leading-[1] font-semibold tracking-[-0.04em] break-words text-foreground text-balance"
          >
            {source.sourceTitle}
          </h1>
        </header>

        <section aria-label={`Notes from ${source.title}`} class="border-t border-hairline">
          <ol>
            {notes.map((note: (typeof noteEntries)[number], index: number) => (
              <li class="border-t border-hairline">
                <a
                  class="grid grid-cols-[2.5rem_1fr] items-baseline gap-x-4 gap-y-1 py-6 sm:grid-cols-[3.5rem_1fr_auto] sm:py-7"
                  href={`/notes/${note.data.topic}/${sourceSlug(note.data.sourceTitle)}/${note.data.slug}/`}
                >
                  <span class="font-mono text-[0.6875rem] tracking-[0.14em] text-muted-foreground">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="text-lg leading-snug font-medium tracking-[-0.01em] text-foreground sm:text-xl">
                    {note.data.title}
                  </span>

                  {note.data.reference && (
                    <span class="col-start-2 row-start-2 text-sm text-muted-foreground sm:col-start-3 sm:row-start-1 sm:text-right">
                      {note.data.reference}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <SiteFooter
        backHref={`/notes/${Astro.params.slug}/`}
        backLabel={topic.data.name}
      />
    </div>
  </main>
</Layout>
