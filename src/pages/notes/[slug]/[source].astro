---
import Layout from "@/layouts/main.astro"
import SiteFooter from "@/components/site-footer.astro"
import SiteHeader from "@/components/site-header.astro"
import { notes as noteEntries, sourceSlug, topics } from "@/lib/topics"

export function getStaticPaths() {
  const groups = new Map()
  for (const note of noteEntries) {
    const key = `${note.data.topic}/${sourceSlug(note.data.sourceTitle)}`
    const group = groups.get(key) ?? []
    group.push(note)
    groups.set(key, group)
  }
  return Array.from(groups.values()).flatMap((group) => {
    const note = group[0]
    const topic = topics.find(({ data }) => data.slug === note.data.topic)
    if (!topic) return []
    return {
      params: {
        slug: note.data.topic,
        source: sourceSlug(note.data.sourceTitle),
      },
      props: {
        topic,
        source: note.data,
        notes: group,
      },
    }
  })
}

const { topic, source, notes } = Astro.props
---

<Layout>
  <main class="min-h-svh">
    <div class="mx-auto flex min-h-svh w-full max-w-6xl flex-col bg-background">
      <SiteHeader />

      <div class="mx-auto w-full max-w-3xl flex-1 px-6 pb-16 pt-10 sm:px-10 sm:pt-14 md:px-12 md:pt-16">
        <header class="pb-8 sm:pb-10">
          <p class="text-xs font-medium uppercase tracking-[0.12em] text-muted-foreground">
            {source.sourceKind}
          </p>
          <h1 class="break-words text-3xl leading-tight font-semibold tracking-[-0.03em] sm:text-4xl md:text-5xl">
            {source.sourceTitle}
          </h1>
        </header>

        <section aria-label={`Notes from ${source.title}`}>
          <ol class="grid gap-3 sm:gap-4">
            {notes.map((note: (typeof noteEntries)[number]) => (
              <li>
                <a
                  class="block rounded-xl border border-border bg-card p-4 transition-colors duration-200 hover:border-foreground/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring sm:p-5"
                  href={`/notes/${note.data.topic}/${sourceSlug(note.data.sourceTitle)}/${note.data.slug}/`}
                >
                  <h2 class="text-lg font-medium tracking-tight underline decoration-border underline-offset-4 sm:text-xl">
                    {note.data.title}
                  </h2>
                  <span class="mt-1 block text-xs leading-5 text-muted-foreground">
                    {note.data.reference}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <SiteFooter
        backHref={`/notes/${Astro.params.slug}/`}
        backLabel={topic.data.name}
      />
    </div>
  </main>
</Layout>
