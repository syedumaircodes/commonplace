---
import Layout from "@/layouts/main.astro"
import { notes as noteEntries, sourceSlug, topics } from "@/lib/topics"
import { SITE } from "@/lib/site"

export function getStaticPaths() {
  const groups = new Map()
  for (const note of noteEntries) {
    const key = `${note.data.topic}/${sourceSlug(note.data.sourceTitle)}`
    const group = groups.get(key) ?? []
    group.push(note)
    groups.set(key, group)
  }
  return Array.from(groups.values()).flatMap((group) => {
    const note = group[0]
    const topic = topics.find(({ data }) => data.slug === note.data.topic)
    if (!topic) return []
    return {
      params: {
        slug: note.data.topic,
        source: sourceSlug(note.data.sourceTitle),
      },
      props: {
        topic,
        source: note.data,
        notes: group,
      },
    }
  })
}

const { topic, source, notes } = Astro.props
---

<Layout
  title={source.sourceTitle}
  description={`${source.sourceTitle}${source.sourceDetail ? ` — ${source.sourceDetail}` : ""}. Notes from ${SITE.name}, curated by ${SITE.author.handle}.`}
>
  <main class="min-h-svh">
    <div class="mx-auto flex min-h-svh w-full max-w-3xl flex-col bg-background">
      <div class="mx-auto w-full max-w-3xl flex-1 px-6 sm:px-10">
        <header class="flex flex-col justify-center py-14 sm:py-18">
          <p class="label-caps mb-3">
            <a
              href={`/notes/${topic.data.slug}/`}
              class="hover:text-foreground"
            >
              {topic.data.name}
            </a>
          </p>
          <h1 class="display-type text-title max-w-[26ch] break-words text-foreground">
            {source.sourceTitle}
          </h1>
          {source.sourceDetail && (
            <p class="mt-4 max-w-[52ch] font-serif text-[1.125rem] leading-[1.5] text-muted-foreground italic">
              {source.sourceDetail}
            </p>
          )}
        </header>

        <section aria-label={`Notes from ${source.sourceTitle}`}>
          <h2 class="label-caps mb-2">Notes</h2>
          <ol>
            {notes.map((note: (typeof noteEntries)[number]) => (
              <li class="border-t border-hairline">
                <a
                  class="block py-6 sm:py-7"
                  href={`/notes/${note.data.topic}/${sourceSlug(note.data.sourceTitle)}/${note.data.slug}/`}
                >
                  <span class="display-type block text-[1.4375rem] leading-[1.2] text-foreground sm:text-[1.5625rem]">
                    {note.data.title}
                  </span>

                  {note.data.reference && (
                    <span class="mt-1.5 block text-[0.8125rem] text-muted-foreground">
                      {note.data.reference}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </div>
  </main>
</Layout>
