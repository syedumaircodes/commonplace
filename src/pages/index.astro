---
import Layout from "@/layouts/main.astro"
import { topics } from "@/lib/topics"
import { SITE } from "@/lib/site"

const collections = topics.map(({ data }, index) => ({
  ...data,
  href: `/notes/${data.slug}/`,
  size: ["2.125rem", "2.5rem", "1.875rem"][index % 3],
}))
---

<Layout description={SITE.description}>
  <!-- Disclaimer banner -->
  <aside
    class="border-b border-hairline bg-background"
    role="note"
    aria-label="Disclaimer"
  >
    <p class="mx-auto max-w-3xl px-6 py-3 text-[0.875rem] leading-[1.6] text-muted-foreground sm:px-10">
      These are my personal notes — they don’t cover everything from the
      sources. I only keep what I need.
    </p>
  </aside>

  <main class="flex min-h-svh flex-col bg-background">
    <section class="mx-auto flex w-full max-w-3xl flex-1 flex-col px-6 sm:px-10">
      <!-- Hero -->
      <div class="flex flex-1 flex-col justify-center py-20 sm:py-24">
        <h1 class="font-display max-w-[22ch] text-[clamp(2.25rem,6vw,3.75rem)] leading-[1.06] font-normal text-foreground text-balance">
          Welcome to my personal spirit library
        </h1>

        <p class="mt-8 max-w-xl text-[1.0625rem] leading-[1.75] text-muted-foreground">
          Kept the way Wan Shi Tong kept his library in{" "}
          <span class="text-foreground italic">Avatar.</span> I’m Syed Umair Ali
          —{" "}
          <a
            href={SITE.author.url}
            target="_blank"
            rel="me noopener noreferrer"
            class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
          >
            {SITE.author.handle}
          </a>
          . Everything I learn gets saved here and revisited. The library grows
          as I grow.
        </p>
      </div>

      <!-- The garden path -->
      <section id="collections" class="scroll-mt-16">
        <h2 class="label-caps mb-2">Collections</h2>
        <ul>
          {collections.map((collection) => (
            <li class="border-t border-hairline">
              <a href={collection.href} class="block py-7 sm:py-8">
                <span
                  class="font-display block text-foreground"
                  style={`font-size: ${collection.size}; line-height: 1.15;`}
                >
                  {collection.name}
                </span>

                <span class="mt-2.5 block max-w-[52ch] text-[0.9375rem] leading-[1.7] text-muted-foreground">
                  {collection.description}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </section>
  </main>
</Layout>
