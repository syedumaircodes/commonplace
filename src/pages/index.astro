---
import Layout from "@/layouts/main.astro"
import SiteFooter from "@/components/site-footer.astro"
import SiteHeader from "@/components/site-header.astro"
import { topics } from "@/lib/topics"

const collections = topics.map(({ data }) => ({
  ...data,
  href: `/notes/${data.slug}/`,
}))
---

<Layout>
  <main class="flex min-h-svh flex-col bg-background">
    <SiteHeader />

    <section class="mx-auto flex w-full max-w-6xl flex-1 flex-col px-6 sm:px-10 lg:px-16">
      <!-- Hero -->
      <div class="flex flex-1 flex-col justify-center py-20 sm:py-28 lg:py-32">
        <h1
          class="max-w-[18ch] text-[clamp(2.75rem,8vw,6rem)] leading-[0.98] font-semibold tracking-[-0.045em] text-foreground text-balance"
        >
          A garden of notes I keep tending.
        </h1>

        <p
          class="mt-10 max-w-[54ch] text-base leading-relaxed text-muted-foreground sm:text-lg"
        >
          I’m Syed Umair Ali — <span class="text-foreground">syedumaircodes</span
          >. Everything I learn gets planted here and revisited. Nothing here is finished;
          it grows as I go.
        </p>
      </div>

      <!-- Collections -->
      <section id="collections" class="scroll-mt-16">
        <ul>
          {
            collections.map((collection) => (
              <li>
                <a
                  href={collection.href}
                  class="block py-6 sm:py-7"
                >
                  <span class="text-2xl leading-tight font-medium tracking-[-0.02em] text-foreground sm:text-3xl">
                    {collection.name}
                  </span>

                  <span class="mt-2 block max-w-[52ch] text-sm leading-relaxed text-muted-foreground">
                    {collection.description}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </section>

    <SiteFooter tagline="Collected with curiosity." />
  </main>
</Layout>
