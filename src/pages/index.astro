---
import { Image } from "astro:assets"
import Layout from "@/layouts/main.astro"
import { notes, sourceSlug } from "@/lib/notes"
import { SITE } from "@/lib/site"
import heroImage from "@/assets/spirit-library.png"

const sources = Array.from(
  new Map(
    notes.map(({ data }) => [
      sourceSlug(data.sourceTitle),
      {
        title: data.sourceTitle,
        detail: data.sourceDetail,
        kind: data.sourceKind,
        count: 0,
        titles: [] as string[],
      },
    ])
  ).entries()
).map(([sourceSlugValue, data]) => {
  const titles = notes
    .filter(({ data: d }) => sourceSlug(d.sourceTitle) === sourceSlugValue)
    .map(({ data: d }) => d.title)

  return {
    title: data.title,
    detail: data.detail,
    kind: data.kind,
    count: titles.length,
    titles,
    href: `/notes/${sourceSlugValue}/`,
  }
})

---

<Layout description={SITE.description}>
  <main class="flex min-h-svh flex-col bg-background">
    <section
      class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center gap-5 px-6 py-14 sm:px-10 sm:py-16"
    >
      <!-- The library itself — one wide card -->
      <div
        class="card-lift relative flex min-h-[11rem] flex-col justify-end overflow-hidden rounded-[1.75rem] border border-hairline bg-card p-6 sm:min-h-[12.5rem] sm:p-7"
      >
        <Image
          src={heroImage}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 h-full w-full object-cover"
          widths={[640, 1024, 1536]}
          sizes="(min-width: 1024px) 72rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <span
          class="absolute inset-0"
          style="background: linear-gradient(to top, rgb(18 17 17 / 0.55) 0%, rgb(18 17 17 / 0.15) 55%, rgb(18 17 17 / 0.1) 100%);"
          aria-hidden="true"
        ></span>
      </div>

      <!-- The collections — smaller cards -->
      <section id="collections" class="scroll-mt-16">
        <h2 class="mb-4 text-[0.9375rem] text-foreground">Collections</h2>

        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {sources.map((source) => (
            <li class="h-full">
              <a
                href={source.href}
                aria-label={source.title}
                class="card-lift relative flex h-full min-h-[11rem] flex-col justify-end overflow-hidden rounded-[1.75rem] border border-hairline bg-card p-6"
              >
                <span class="relative flex items-start justify-between gap-4">
                  <span class="text-[0.9375rem] text-muted-foreground">
                    {source.kind}
                  </span>
                </span>

                <span class="relative mt-5 block">
                  <span
                    class="display-type block text-[1.375rem] leading-[1.15] text-foreground sm:text-[1.5rem]"
                  >
                    {source.title}
                  </span>

                  {source.detail && (
                    <span
                      class="mt-2 block max-w-[42ch] text-[0.9375rem] leading-[1.6] text-pretty text-muted-foreground"
                    >
                      {source.detail}
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </section>
  </main>
</Layout>
