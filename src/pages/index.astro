---
import Layout from "@/layouts/main.astro"
import { notes, sourceSlug } from "@/lib/notes"
import { SITE } from "@/lib/site"

const ACCENT = "#85b8fc"

const sources = Array.from(
  new Map(notes.map(({ data }) => [sourceSlug(data.sourceTitle), data])).entries()
).map(([sourceSlugValue, data]) => ({
  title: data.sourceTitle,
  detail: data.sourceDetail,
  href: `/notes/${sourceSlugValue}/`,
}))
---

<Layout description={SITE.description}>
  <main class="flex min-h-svh flex-col bg-background">
    <section class="mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-6 py-16 sm:px-10 sm:py-20">
      <!-- The shelves -->
      <section id="collections" class="scroll-mt-16">
        <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {sources.map((source) => (
            <li>
              <a
                href={source.href}
                class="group relative flex h-64 overflow-hidden rounded-md border border-hairline bg-card"
              >
                <!-- Spine -->
                <span
                  class="relative flex w-9 shrink-0 flex-col items-center justify-between border-r border-hairline"
                  style={`background: linear-gradient(to right, rgb(0 0 0 / 0.35), transparent 65%), color-mix(in oklab, ${ACCENT} 10%, var(--card));`}
                  aria-hidden="true"
                >
                </span>

                <!-- Cover -->
                <span class="relative flex min-w-0 flex-1 flex-col justify-end gap-2 p-5">
                  <span
                    class="pointer-events-none absolute inset-0 opacity-40"
                    style="background: linear-gradient(160deg, rgb(249 249 249 / 0.05) 0%, transparent 38%);"
                    aria-hidden="true"
                  ></span>

                  <span class="display-type relative block text-[1.25rem] leading-[1.2] text-foreground sm:text-[1.375rem]" style="font-weight: 500;">
                    {source.title}
                  </span>

                  {source.detail && (
                    <span class="relative block max-w-[42ch] text-[0.875rem] leading-[1.55] text-pretty text-muted-foreground">
                      {source.detail}
                    </span>
                  )}
                </span>

                <!-- Page edges -->
                <span
                  class="w-1.5 shrink-0"
                  style={`background: repeating-linear-gradient(to right, rgb(249 249 249 / 0.14) 0px, rgb(249 249 249 / 0.14) 1px, transparent 1px, transparent 3px), rgb(0 0 0 / 0.25);`}
                  aria-hidden="true"
                ></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </section>
  </main>
</Layout>
