---
interface Props {
  backHref?: string
  backLabel?: string
  tagline?: string
}

const { backHref, backLabel, tagline } = Astro.props
---

<footer>
  <div
    class="mx-auto flex w-full max-w-3xl flex-col items-start gap-1 px-6 py-8 text-[0.8125rem] text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-10"
  >
    {
      backHref && backLabel ? (
        <a
          href={backHref}
          class="inline-flex min-h-8 items-center gap-1.5 hover:text-foreground"
        >
          <span aria-hidden="true">←</span>
          <span>{backLabel}</span>
        </a>
      ) : (
        <span>{tagline}</span>
      )
    }
    <span>© {new Date().getFullYear()} commonplace</span>
  </div>
</footer>
