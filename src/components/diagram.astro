---
import { render } from "pele"

interface Props {
  /** Mermaid source. */
  source: string
  /** Accessible description of the diagram. */
  label?: string
  /** Optional visible caption below the diagram. */
  caption?: string
}

const { source, label, caption } = Astro.props

const fontFamily = '"Literata Variable", Georgia, "Times New Roman", serif'

const { svg } = render(source, { fontFamily })

const labelled = svg.replace(
  "<svg ",
  `<svg role="img"${label ? ` aria-label="${label.replace(/"/g, "&quot;")}"` : ""} `
)
---

<figure class="diagram my-8 not-prose">
  <div
    class="diagram-frame overflow-x-auto rounded-lg border border-hairline bg-card/40 p-4 sm:p-6"
    set:html={labelled}
  />
  {caption && (
    <figcaption class="mt-3 text-[0.8125rem] leading-relaxed text-muted-foreground">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .diagram :global(svg) {
    width: 100%;
    height: auto;
    max-width: 100%;
  }
</style>
