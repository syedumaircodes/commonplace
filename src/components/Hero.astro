---
const { entry } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero ?? {};
---

<div class="hero">
	<div class="hero-backdrop" aria-hidden="true">
		<div class="hero-grid"></div>
		<div class="hero-glow"></div>
	</div>

	<div class="hero-copy">
		<p class="eyebrow">
			<span class="eyebrow-dot" aria-hidden="true"></span>
			SpiritLibrary — personal notes
		</p>

		<h1 id="_top" data-page-title set:html={title} />

		{tagline && <p class="tagline" set:html={tagline} />}

		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ text, link: href, variant = 'primary' }) => {
						const external = /^https?:\/\//.test(href);
						return (
							<a
								class:list={['action', `is-${variant}`]}
								href={href}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
							>
								<span>{text}</span>
								{external ? (
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<path
											d="M6.5 3.5H3.75A1.25 1.25 0 0 0 2.5 4.75v7.5A1.25 1.25 0 0 0 3.75 13.5h7.5A1.25 1.25 0 0 0 12.5 12.25V9.5M9 2.5h4.5V7M13 3 7.25 8.75"
											fill="none"
											stroke="currentColor"
											stroke-width="1.2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								) : (
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<path
											d="M8 2.75v10.5M3.75 8.75 8 13l4.25-4.25"
											fill="none"
											stroke="currentColor"
											stroke-width="1.2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								)}
							</a>
						);
					})}
				</div>
			)
		}
	</div>
</div>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		padding-block: clamp(4rem, 9vw, 8rem) clamp(2.5rem, 5vw, 4rem);
	}

	.hero-backdrop {
		position: absolute;
		inset: 0;
		z-index: -1;
		overflow: hidden;
	}

	/* Geist's signature hairline grid, fading out towards the content. */
	.hero-grid {
		position: absolute;
		inset: 0;
		background-image: linear-gradient(to right, var(--ds-gray-alpha-100) 1px, transparent 1px);
		background-size: calc(100% / 12) 100%;
		-webkit-mask-image: radial-gradient(ellipse 90% 75% at 50% 0%, #000 0%, transparent 78%);
		mask-image: radial-gradient(ellipse 90% 75% at 50% 0%, #000 0%, transparent 78%);
	}

	.hero-glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			55% 45% at 50% 0%,
			color-mix(in srgb, var(--accent) 10%, transparent),
			transparent 70%
		);
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-faint);
		animation: rise 0.8s var(--ease-out) 0.05s both;
	}

	.eyebrow-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		animation: pulse 2.4s var(--ease-in-out) infinite;
	}

	h1 {
		margin: 1.25rem 0 0;
		max-width: 12ch;
		font-family: var(--font-display);
		font-size: clamp(3.25rem, 8.5vw, 8rem);
		font-weight: 400;
		line-height: 0.94;
		letter-spacing: -0.035em;
		color: var(--ink);
		text-wrap: balance;
		animation: title-in 1s var(--ease-out) 0.12s both;
	}

	/* Geist Serif has no italic — the variable font's ELSH axis carries the
	   emphasis instead, and it morphs on hover. */
	h1 :global(em) {
		font-style: normal;
		color: var(--accent);
		font-variation-settings: 'ELSH' 0;
		transition: font-variation-settings 700ms var(--ease-out);
	}

	h1 :global(em):hover {
		font-variation-settings: 'ELSH' 100;
	}

	.tagline {
		margin: 1.5rem 0 0;
		max-width: 42ch;
		font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
		line-height: 1.6;
		color: var(--ink-muted);
		text-wrap: pretty;
		animation: rise 0.9s var(--ease-out) 0.3s both;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.5rem;
		animation: rise 0.9s var(--ease-out) 0.42s both;
	}

	.action {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.75rem 1.25rem;
		border: 1px solid transparent;
		border-radius: var(--radius-md);
		font-size: 0.9375rem;
		font-weight: 500;
		letter-spacing: -0.005em;
		text-decoration: none;
		transition:
			background-color 300ms var(--ease-swift),
			border-color 300ms var(--ease-swift),
			color 300ms var(--ease-swift),
			transform 300ms var(--ease-swift);
	}

	.action.is-primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}

	.action.is-primary:hover {
		background: var(--accent-hover);
		border-color: var(--accent-hover);
		transform: translateY(-1px);
	}

	.action.is-secondary {
		background: transparent;
		border-color: var(--line-strong);
		color: var(--ink);
	}

	.action.is-secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-1px);
	}

	.action svg {
		width: 1rem;
		height: 1rem;
		transition: transform 400ms var(--ease-out);
	}

	.action.is-primary:hover svg {
		transform: translateY(2px);
	}

	.action.is-secondary:hover svg {
		transform: translate(2px, -2px);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* The clip region extends past the box so descenders (e.g. the italic
	   "g" in "keeping.") are never shaved off. */
	@keyframes title-in {
		from {
			opacity: 0;
			transform: translateY(28px);
			clip-path: inset(-0.3em -0.2em 24% -0.2em);
		}
		to {
			opacity: 1;
			transform: translateY(0);
			clip-path: inset(-0.3em -0.2em -0.3em -0.2em);
		}
	}

	@keyframes pulse {
		0%,
		100% {
			transform: scale(1);
			opacity: 1;
		}
		50% {
			transform: scale(1.6);
			opacity: 0.55;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.eyebrow,
		h1,
		.tagline,
		.actions {
			animation: none;
		}

		.eyebrow-dot {
			animation: none;
		}

		h1 :global(em) {
			transition: none;
		}
	}
</style>
