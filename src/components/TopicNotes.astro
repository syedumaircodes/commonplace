---
import { getCollection } from 'astro:content';

interface Props {
	/** Topic slug matching the folder under `src/content/docs/notes/`. */
	topic: string;
}

const { topic } = Astro.props;
const prefix = `notes/${topic}`;

const notes = (await getCollection('docs', ({ id }) => id.startsWith(`${prefix}/`)))
	// Exclude topic and nested section index pages from the note list.
	.filter(({ id }) => !/(^|\/)index$/.test(id))
	// Respect explicit `sidebar.order`, then fall back to filename order.
	.sort((a, b) => {
		const orderA = a.data.sidebar?.order ?? Number.MAX_SAFE_INTEGER;
		const orderB = b.data.sidebar?.order ?? Number.MAX_SAFE_INTEGER;
		return orderA - orderB || a.id.localeCompare(b.id);
	});
---

{
	notes.length === 0 ? (
		<p class="empty-state">
			No notes yet — add an MDX file to this topic’s folder to see it here.
		</p>
	) : (
		<ul class="note-grid">
			{notes.map((note) => (
				<li>
					<a class="note-card" href={`/${note.id}/`}>
						<span class="note-title">{note.data.title}</span>
						{note.data.description && (
							<span class="note-description">{note.data.description}</span>
						)}
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.note-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.note-card {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		height: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		padding: 1rem 1.125rem;
		background: var(--surface);
		color: inherit;
		text-decoration: none;
		transition:
			background-color 300ms var(--ease-swift),
			border-color 300ms var(--ease-swift),
			transform 300ms var(--ease-swift);
	}

	.note-card:hover,
	.note-card:focus-visible {
		background: color-mix(in srgb, var(--accent) 6%, var(--surface));
		border-color: var(--accent);
		transform: translateY(-1px);
	}

	.note-title {
		font-size: 0.9375rem;
		font-weight: 550;
		line-height: 1.4;
		color: var(--ink);
	}

	.note-description {
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.empty-state {
		margin: 0;
		border: 1px dashed var(--line-strong);
		border-radius: var(--radius-md);
		padding: 1.5rem;
		color: var(--ink-faint);
		font-size: 0.9375rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.note-card {
			transition: none;
		}
	}
</style>
