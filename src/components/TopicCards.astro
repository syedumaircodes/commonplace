---
import { topics } from '@/data/topics';

const kindLabels = {
	book: 'Book',
	course: 'Course',
	specialization: 'Specialization',
	article: 'Article',
	video: 'Video',
	docs: 'Docs',
} as const;
---


<ol class="topic-list">
	{
		topics.map((topic, index) => (
			<li>
				<a class="topic-row" href={`/notes/${topic.slug}/`}>
					<span class="topic-index" aria-hidden="true">
						{String(index + 1).padStart(2, '0')}
					</span>
					<span class="topic-main">
						<span class="topic-meta">
							<span class="topic-kind">{kindLabels[topic.kind]}</span>
							{topic.source && <span class="topic-source">{topic.source}</span>}
						</span>
						<span class="topic-title">{topic.title}</span>
						<span class="topic-description">{topic.description}</span>
					</span>
					<span class="topic-arrow" aria-hidden="true">
						<svg viewBox="0 0 16 16">
							<path
								d="M4.75 11.25 11.25 4.75M5.75 4.75h5.5v5.5"
								fill="none"
								stroke="currentColor"
								stroke-width="1.2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.topic-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.topic-heading {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.topic-count {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.topic-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
		gap: 0.875rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.topic-list li {
		position: relative;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition:
			background-color 400ms var(--ease-swift),
			border-color 400ms var(--ease-swift),
			box-shadow 400ms var(--ease-swift),
			transform 400ms var(--ease-swift);
	}

	.topic-list li:has(.topic-row:hover),
	.topic-list li:has(.topic-row:focus-visible) {
		background: color-mix(in srgb, var(--accent) 6%, var(--surface));
		border-color: var(--line-active);
		box-shadow: var(--shadow-medium);
		transform: translateY(-2px);
	}

	.topic-row {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: clamp(1rem, 2.5vw, 1.75rem);
		align-items: center;
		height: 100%;
		padding: clamp(1.35rem, 2.4vw, 1.75rem);
		color: inherit;
		text-decoration: none;
	}

	.topic-list.is-reveal .topic-row {
		opacity: 0;
	}

	.topic-list.is-reveal .topic-row.is-visible {
		animation: row-in 0.8s var(--ease-out) var(--reveal-delay, 0ms) both;
	}

	.topic-index {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		color: var(--ink-faint);
		transition: color 400ms var(--ease-swift);
	}

	.topic-row:hover .topic-index,
	.topic-row:focus-visible .topic-index {
		color: var(--accent);
	}

	.topic-main {
		display: block;
		min-width: 0;
	}

	.topic-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.65rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.topic-kind {
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-full);
		color: var(--accent);
		transition:
			border-color 400ms var(--ease-swift),
			background-color 400ms var(--ease-swift);
	}

	.topic-row:hover .topic-kind,
	.topic-row:focus-visible .topic-kind {
		border-color: var(--accent);
		background: var(--accent-subtle);
	}

	.topic-source {
		text-transform: none;
		letter-spacing: 0.01em;
	}

	.topic-title {
		display: block;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.022em;
		color: var(--ink);
		text-wrap: balance;
	}

	.topic-description {
		display: block;
		max-width: 54ch;
		margin-top: 0.5rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--ink-muted);
		text-wrap: pretty;
	}

	.topic-arrow {
		display: grid;
		place-items: center;
		align-self: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--line-strong);
		border-radius: 50%;
		color: var(--ink-muted);
		transition:
			background-color 400ms var(--ease-swift),
			border-color 400ms var(--ease-swift),
			color 400ms var(--ease-swift),
			transform 400ms var(--ease-swift);
	}

	.topic-arrow svg {
		width: 1rem;
		height: 1rem;
		transition: transform 500ms var(--ease-out);
	}

	.topic-row:hover .topic-arrow,
	.topic-row:focus-visible .topic-arrow {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}

	.topic-row:hover .topic-arrow svg,
	.topic-row:focus-visible .topic-arrow svg {
		transform: translate(1px, -1px);
	}

	@keyframes row-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.topic-list.is-reveal .topic-row {
			opacity: 1;
			animation: none;
		}

		.topic-list li,
		.topic-index,
		.topic-kind,
		.topic-arrow,
		.topic-arrow svg {
			transition: none;
		}
	}
</style>

<script>
	const list = document.querySelector<HTMLElement>('.topic-list');
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (list && !reduceMotion) {
		const rows = [...list.querySelectorAll<HTMLElement>('.topic-row')];
		list.classList.add('is-reveal');

		rows.forEach((row, index) => {
			row.style.setProperty('--reveal-delay', `${index * 70}ms`);
		});

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
		);

		rows.forEach((row) => observer.observe(row));
	}
</script>
